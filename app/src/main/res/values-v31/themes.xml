<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Android 12 и новее: системный загрузочный экран берёт иконку и фон из темы SplashActivity.
        Экран вертикальный, поэтому иконка показывается в обычном положении — без поворота.
    -->
    <style name="Theme.SportStreamer.Splash" parent="Theme.SportStreamer">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBackground">#FF060709</item>
    </style>
</resources>
