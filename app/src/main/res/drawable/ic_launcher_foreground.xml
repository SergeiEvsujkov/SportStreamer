<?xml version="1.0" encoding="utf-8"?>
<!--
    Передний план адаптивной иконки — готовая картинка 432×432 (drawable-nodpi/logo_foreground.png):
    логотип уже вписан в безопасную зону (68% кадра, то есть 66 из 108 dp) и его края растворены
    в собственном фоне картинки, поэтому границы вставки не видно на любой маске.
    gravity="fill" — растянуть слой на всю область 108×108 dp.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="fill"
    android:src="@drawable/logo_foreground" />
